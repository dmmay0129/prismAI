{
  "speech": {
    "model_size": "tiny",
    "device": "cpu",
    "compute_type": "int8",
    "language": "zh",
    "beam_size": 5,
    "vad_filter": true
  },
  "content": {
    "ollama_url": "http://localhost:11434/api/generate",
    "model": "qwen2:1.5b",
    "timeout_sec": 30
  },
  "vision": {
    "max_frames": 30,
    "scale_factor": 1.1,
    "min_neighbors": 5,
    "profile_cascade": true
  },
  "input": {
    "max_audio_sec": 600,
    "max_video_sec": 600,
    "max_upload_mb": 200,
    "temp_dir": null
  },
  "storage": {
    "history_limit": 20
  },
  "auth": {
    "idle_timeout_sec": 3600
  },
  "concurrency": {
    "max_concurrent_analyses": 1,
    "queue_timeout_sec": 120
  }
}
